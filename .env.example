# Copy to .env (never commit it). No API keys of any kind: the reader is `claude -p` on the logged-in subscription.

# --- Postgres (compose creates DBs folio and langfuse on first boot) ---
POSTGRES_USER=folio
POSTGRES_PASSWORD=change-me-url-safe          # openssl rand -hex 24
# Used by api, worker and `alembic`. Host is the compose service name.
DATABASE_URL=postgresql+psycopg://folio:change-me-url-safe@postgres:5432/folio

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333

# --- Claude headless (worker only) ---
# Host dir holding the logged-in CLI session (mounted into the worker as /home/folio/.claude, owner uid 1000).
CLAUDE_HOST_DIR=/home/ubuntu/.claude
CLAUDE_CONFIG_DIR=/home/folio/.claude

# --- Langfuse v2 (optional tracing; unset the keys and tracing is a no-op) ---
LANGFUSE_NEXTAUTH_SECRET=change-me             # openssl rand -hex 32
LANGFUSE_SALT=change-me                        # openssl rand -hex 32
LANGFUSE_NEXTAUTH_URL=http://localhost:3100
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Ollama (optional, `--profile local-llm`) ---
OLLAMA_URL=http://ollama:11434

# --- Ports published on the host ---
NGINX_PORT=80
QDRANT_PORT=6333
LANGFUSE_PORT=3100

# --- Compose ---
COMPOSE_PROJECT_NAME=folio
